@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO / CARRUSEL -->
<section class="hero">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1>ProyectoPyme</h1>
            <p>Gestión moderna de productos y categorías para pequeñas empresas.</p>
            <a href="/Productos" class="btn-hero">Ver Productos</a>
        </div>
    </div>
</section>

<!-- SOBRE LA PYME -->
<section class="about-section">
    <div class="about-container">
        <div class="about-img">
            <img src="@Url.Content("~/img/about.jpg")" alt="Sobre la Pyme">
        </div>
        <div class="about-text">
            <h2>Sobre Nuestra Pyme</h2>
            <p>
                La esencia que te define comienza aquí.
                Este año abrimos nuestras puertas digitales para ofrecerte perfumes originales, sofisticados y pensados para cada ocasión.
            </p>
            <a href="/Categorias" class="btn-dark">Explorar Categorías</a>
        </div>
    </div>
</section>

<!-- PRODUCTOS DESTACADOS -->
<section class="products-section">
    <h2 class="section-title">Productos Destacados</h2>

    <div class="product-grid">
        @for (int i = 1; i <= 8; i++)
        {
            <div class="product-card">
                <img src="@Url.Content("~/img/producto-demo.jpg")" alt="Producto demo">
                <h4>Producto @i</h4>
                <p>Descripción breve del producto.</p>
                <span class="price">$149.00</span>
            </div>
        }
    </div>
</section>

<!-- BLOG / NOTICIAS -->
<section class="blog-section">
    <h2 class="section-title">Noticias & Actualizaciones</h2>

    <div class="blog-grid">
        @for (int i = 1; i <= 3; i++)
        {
            <div class="blog-card">
                <img src="@Url.Content("~/img/blog-demo.jpg")" alt="Blog">
                <h4>Título del Artículo @i</h4>
                <p>
                    Breve descripción del contenido del artículo
                    relacionado con la Pyme o el sistema.
                </p>
                <a href="#" class="btn-light">Leer más</a>
            </div>
        }
    </div>
</section>

<!-- FOOTER -->
<footer class="main-footer">
    <div class="footer-container">

        <div>
            <h4>ProyectoPyme</h4>
            <p>Sistema MVC para gestión académica empresarial.</p>
        </div>

        <div>
            <h4>Enlaces</h4>
            <ul>
                <li><a href="/Productos">Productos</a></li>
                <li><a href="/Categorias">Categorías</a></li>
                <li><a href="/Cuentas/Login">Login</a></li>
            </ul>
        </div>

        <div>
            <h4>Contacto</h4>
            <p>Email: info@proyectopyme.com</p>
            <p>Tel: +000 123456</p>
        </div>

    </div>

    <div class="footer-bottom">
        © @DateTime.Now.Year - ProyectoPyme
    </div>
</footer>