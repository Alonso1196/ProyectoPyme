@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO / CARRUSEL -->
<section class="hero">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1>ProyectoPyme</h1>
            <p>Gestión moderna de productos y categorías para pequeñas empresas.</p>
            <a href="/Productos" class="btn-hero">Ver Productos</a>
        </div>
    </div>
</section>

<!-- PRODUCTOS DESTACADOS -->
<section class="products-section">
    <h2 class="section-title">Productos Destacados</h2>

    <div class="product-grid">

        <div class="product-card">
            <img src="@Url.Content("~/images/Productos/Jean Paul Gaultier Le Male Le Parfum.jfif")" alt="Jean Paul Gaultier Le Male Le Parfum">
            <h4>Jean Paul Gaultier Le Male Le Parfum</h4>
            <p>Una fragancia intensa con notas de vainilla, cardamomo y lavanda que transmite elegancia y carácter.</p>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Productos" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Comprar
                </a>
            }
            else
            {
                <a href="/Cuentas/Login" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Iniciar sesión para comprar
                </a>
            }
        </div>

        <div class="product-card">
            <img src="@Url.Content("~/images/Productos/Invictus legend Paco Rabanne.jfif")" alt="Invictus Legend Paco Rabanne">
            <h4>Invictus Legend - Paco Rabanne</h4>
            <p>Fragancia poderosa con notas marinas y amaderadas que evocan fuerza y espíritu ganador.</p>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Productos" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Comprar
                </a>
            }
            else
            {
                <a href="/Cuentas/Login" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Iniciar sesión para comprar
                </a>
            }
        </div>

        <div class="product-card">
            <img src="@Url.Content("~/images/Productos/Carolina Herrera 212 Sexy.jfif")" alt="Carolina Herrera 212 Sexy">
            <h4>Carolina Herrera 212 Sexy</h4>
            <p>Aroma seductor con notas de vainilla, almizcle y pimienta rosa ideal para la noche.</p>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Productos" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Comprar
                </a>
            }
            else
            {
                <a href="/Cuentas/Login" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Iniciar sesión para comprar
                </a>
            }
        </div>

        <div class="product-card">
            <img src="@Url.Content("~/images/Productos/Valentino Born In Roma Intense Eau De Parfum.jfif")" alt="Valentino Born In Roma Intense">
            <h4>Valentino Born In Roma Intense</h4>
            <p>Fragancia moderna con vainilla bourbon y ámbar que representa lujo y sofisticación.</p>
            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Productos" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Comprar
                </a>
            }
            else
            {
                <a href="/Cuentas/Login" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Iniciar sesión para comprar
                </a>
            }
        </div>

    </div>
</section>

<!-- PERFUMES EN OFERTA -->
<section class="ofertas-section">
    <h2 class="section-title">🔥 Perfumes en Oferta</h2>

    <div class="ofertas-grid">

        <!-- Perfume 1 -->
        <div class="oferta-card">
            <span class="badge-oferta">-30%</span>
            <img src="@Url.Content("~/images/Productos/Sauvage Dior .jfif")" alt="Perfume Dior">
            <h4>Dior Sauvage</h4>

            <p class="precio">
                <span class="precio-antiguo">$120</span>
                <span class="precio-nuevo">$84</span>
            </p>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Productos" class="btn-oferta">
                    <i class="fa-solid fa-cart-shopping"></i> Comprar
                </a>
            }
            else
            {
