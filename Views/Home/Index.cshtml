@{
    ViewData["Title"] = "Inicio";
}

<div class="container" style="margin-top: 20px;">
    <h2>ProyectoPyme</h2>
    <p>Seleccione una opción para continuar.</p>

    <div style="display:flex; gap:16px; flex-wrap:wrap; margin-top:16px;">

        <!-- Productos (público) -->
        <a href="/Productos" style="text-decoration:none;">
            <div style="border:1px solid #ddd; padding:16px; border-radius:10px; width:260px;">
                <h4 style="margin:0 0 8px;">📦 Productos</h4>
                <p style="margin:0;">Ver disponibilidad de artículos.</p>
            </div>
        </a>

        <!-- Categorías (público) -->
        <a href="/Categorias" style="text-decoration:none;">
            <div style="border:1px solid #ddd; padding:16px; border-radius:10px; width:260px;">
                <h4 style="margin:0 0 8px;">🏷️ Categorías</h4>
                <p style="margin:0;">Explorar categorías disponibles.</p>
            </div>
        </a>

        <!-- Login/Logout (condicional) -->
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form method="post" action="/Cuentas/Logout">
                <button type="submit" style="border:1px solid #dc3545; background:#dc3545; color:white; padding:16px; border-radius:10px; width:260px; text-align:left;">
                    <h4 style="margin:0 0 8px;">🚪 Cerrar sesión</h4>
                    <p style="margin:0;">Salir de la cuenta actual.</p>
                </button>
            </form>
        }
        else
        {
            <a href="/Cuentas/Login" style="text-decoration:none;">
                <div style="border:1px solid #198754; background:#198754; color:white; padding:16px; border-radius:10px; width:260px;">
                    <h4 style="margin:0 0 8px;">🔐 Iniciar sesión</h4>
                    <p style="margin:0;">Acceder como Cliente o Admin.</p>
                </div>
            </a>
        }
    </div>

    <hr style="margin:24px 0;" />

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <p>
            Sesión activa: <strong>@User.Identity.Name</strong>
            @if (User.IsInRole("Admin"))
            {
                <span> (Admin)</span>
            }
            else if (User.IsInRole("Cliente"))
            {
                <span> (Cliente)</span>
            }
        </p>
    }
    else
    {
        <p><em>Estás navegando como visitante.</em></p>
    }
</div>
