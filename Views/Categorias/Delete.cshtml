@model ProyectoPyme.Models.Categoria
@{ ViewData["Title"] = "Eliminar Categoría"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="ordenes-container">
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <h2><i class="fa-solid fa-trash" style="color:#f87171;"></i> Eliminar Categoría</h2>
    <a href="/Admin/Categorias" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Volver</a>
</div>
<div class="form-card">
    <div class="delete-box">
        <p style="color:var(--text-sec);">¿Está seguro que desea eliminar la categoría?</p>
        <h3>@Model.Nombre</h3>
        <form method="post" class="actions" style="margin-top:20px;">
            <input type="hidden" asp-for="CategoriaId" />
            <button type="submit" class="btn danger"><i class="fa-solid fa-trash"></i> Sí, eliminar</button>
            <a href="/Admin/Categorias" class="btn-back">Cancelar</a>
        </form>
    </div>
</div>
</div>
