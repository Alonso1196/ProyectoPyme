@model ProyectoPyme.Models.Categoria
@{ ViewData["Title"] = "Editar Categoría"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="ordenes-container">
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <h2><i class="fa-solid fa-pen" style="color:var(--amber-light);"></i> Editar Categoría</h2>
    <a href="/Admin/Categorias" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Volver</a>
</div>

<form method="post" class="form-card">
    <div class="field">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="input" />
        <span asp-validation-for="Nombre" class="error"></span>
    </div>
    <div class="field">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="input"></textarea>
        <span asp-validation-for="Descripcion" class="error"></span>
    </div>
    <div class="actions">
        <button type="submit" class="btn primary amber"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
        <a href="/Admin/Categorias" class="btn-back">Cancelar</a>
    </div>
</form>
</div>
