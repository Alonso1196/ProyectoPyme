@model IEnumerable<ProyectoPyme.Models.Categoria>
@{ ViewData["Title"] = "Categorías"; Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_Layout.cshtml"; }

@if (User.IsInRole("Admin"))
{
    <div class="ordenes-container">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
        <h2><i class="fa-solid fa-layer-group" style="color:var(--amber-light);"></i> Categorías de Perfumes</h2>
        <a href="/Admin/Categorias/Create" class="btn primary amber"><i class="fa-solid fa-plus"></i> Nueva categoría</a>
    </div>
    <div class="search-bar">
        <div class="search-field">
            <label for="adminCatSearch"><i class="fa-solid fa-magnifying-glass"></i> Búsqueda</label>
            <input type="text" id="adminCatSearch" class="search-input" placeholder="Nombre o descripción..." />
        </div>
    </div>
    <div class="admin-table-wrap">
        <table id="adminCategoriasTable" class="admin-table">
            <thead>
                <tr><th>ID</th><th>Nombre</th><th>Descripción</th><th style="text-align:right;">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CategoriaId</td>
                        <td class="text-white">@c.Nombre</td>
                        <td>@c.Descripcion</td>
                        <td>
                            <div class="action-btns">
                                <a href="/Admin/Categorias/Edit/@c.CategoriaId" class="action-btn edit" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <a href="/Admin/Categorias/Delete/@c.CategoriaId" class="action-btn delete" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
else
{
    <div class="client-page-banner">
        <img src="@Url.Content(ImagePaths.Productos + "/TH-1.png")" alt="Thompson" class="banner-logo" />
        <div>
            <h2><i class="fa-solid fa-layer-group" style="color:var(--amber-light);"></i> Categorías</h2>
            <p class="muted">Explorá nuestras familias olfativas</p>
        </div>
    </div>
    <div class="user-cat-cards">
        @foreach (var c in Model)
        {
            <a asp-controller="Productos" asp-action="Categoria" asp-route-id="@c.CategoriaId" class="u-cat-link" style="text-decoration:none;color:inherit;">
                <div class="u-cat-card">
                    <div class="u-cat-icon"><i class="fa-solid fa-layer-group"></i></div>
                    <h3>@c.Nombre</h3>
                    <p>@c.Descripcion</p>
                </div>
            </a>
        }
    </div>
    <div class="no-results" id="noResultsCatClient">No se encontraron categorías con ese criterio.</div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // ===================== ADMIN: DataTable =====================
            if ($('#adminCategoriasTable').length) {
                var table = $('#adminCategoriasTable').DataTable({
                    paging: true, searching: true, pageLength: 10, lengthMenu: [5, 10, 25, 50],
                    language: {
                        lengthMenu: "Mostrar _MENU_ por página",
                        zeroRecords: "No se encontraron resultados",
                        info: "Mostrando página _PAGE_ de _PAGES_",
                        infoEmpty: "No hay registros disponibles",
                        infoFiltered: "(filtrado de _MAX_ registros totales)",
                        search: "Buscar:",
                        paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                    }
                });

                $('#adminCatSearch').on('keyup', function () {
                    table.search($(this).val()).draw();
                });
            }


        });
    </script>
}
