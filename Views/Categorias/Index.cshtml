@model IEnumerable<ProyectoPyme.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h2 class="page-title">Categorías</h2>

<div class="top-actions">
    @if (User.IsInRole("Admin"))
    {
        <a href="/Categorias/Create" class="btn primary">Nueva Categoría</a>
    }
</div>

<div class="card-grid">
    @foreach (var c in Model)
    {
        <div class="card">
            <h3>@c.Nombre</h3>
            <p class="muted">@c.Descripcion</p>

            @if (User.IsInRole("Admin"))
            {
                <div class="actions">
                    <a href="/Categorias/Edit/@c.CategoriaId" class="btn ghost">Editar</a>
                    <a href="/Categorias/Delete/@c.CategoriaId" class="btn danger">Eliminar</a>
                </div>
            }
        </div>
    }
</div>
