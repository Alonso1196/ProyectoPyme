@model IEnumerable<ProyectoPyme.Models.Categoria>

<h2>Categorías</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">Nueva Categoría</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>@c.Descripcion</td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@c.CategoriaId">Editar</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@c.CategoriaId">Eliminar</a>
                    }
                    else
                    {
                        <span>Solo lectura</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
