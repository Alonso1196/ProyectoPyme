@model ProyectoPyme.Models.Categoria

<h2>Nueva Categoría</h2>

<form method="post">
    <div>
        <label>Nombre</label>
        <input asp-for="Nombre" />
    </div>

    <div>
        <label>Descripción</label>
        <input asp-for="Descripcion" />
    </div>

    <button type="submit">Guardar</button>
</form>

<a asp-action="Index">Volver</a>
