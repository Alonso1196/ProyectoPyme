@model ProyectoPyme.Models.Categoria

<h2 class="page-title">Nueva Categoría</h2>

<form method="post" class="form-card">
    <div class="field">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="input" />
        <span asp-validation-for="Nombre" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="input"></textarea>
        <span asp-validation-for="Descripcion" class="error"></span>
    </div>

    <div class="actions">
        <button type="submit" class="btn primary">Guardar</button>
        <a href="/Categorias" class="btn ghost">Cancelar</a>
    </div>
</form>
