@model ProyectoPyme.Models.DetalleOrdenViewModel
@{ ViewData["Title"] = "Detalle de Orden"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<h2 class="page-title">
    <i class="fa-solid fa-receipt" style="color:var(--blue-light);"></i>
    Detalle de la Orden <span class="muted">#@Model.Orden.NumeroOrden</span>
</h2>

<div class="order-summary">
    <div class="info-card">
        <h3>Información del Cliente</h3>
        <div class="info-grid">
            <div><span class="label">Nombre</span><span class="value">@Model.Orden.NombreCliente</span></div>
            <div><span class="label">Teléfono</span><span class="value">@Model.Orden.Telefono</span></div>
            <div><span class="label">Dirección</span><span class="value">@Model.Orden.Direccion</span></div>
            <div><span class="label">Fecha</span><span class="value">@Model.Orden.Fecha.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div><span class="label">Estado</span><span class="@(Model.Orden.Estado == "Pendiente" ? "badge-warning" : "badge-success")">@Model.Orden.Estado</span></div>
            <div><span class="label">Total</span><span class="price">@Model.Orden.Total.ToString("C")</span></div>
        </div>
    </div>
</div>

<div style="margin-top:32px;">
    <h3 class="section-title">Productos Comprados</h3>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th style="text-align:right;">Subtotal</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Detalles)
                {
                    <tr>
                        <td class="text-white">@item.NombreProducto</td>
                        <td>@item.Cantidad</td>
                        <td class="text-amber">@item.Precio.ToString("C")</td>
                        <td style="text-align:right;font-weight:700;color:var(--amber-light);">@((item.Cantidad * item.Precio).ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="actions" style="margin-top:24px;">
    <a href="@Url.Action("Ordenes", "Admin")" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Volver a Órdenes</a>
</div>
