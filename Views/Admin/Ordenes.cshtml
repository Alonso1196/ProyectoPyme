@model List<ProyectoPyme.Models.Orden>

<div class="ordenes-container">
    <h2>Órdenes de Clientes</h2>

    <table class="ordenes-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Número Orden</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Acción</th> <!-- Nueva columna -->
            </tr>
        </thead>
        <tbody>
            @foreach (var orden in Model)
            {
                var estadoClase =
                orden.Estado.ToLower() == "pendiente" ? "pendiente" :
                orden.Estado.ToLower() == "pagado" ? "pagado" :
                orden.Estado.ToLower() == "cancelado" ? "cancelado" : "otro";

                <tr>
                    <td>@orden.IdOrden</td>
                    <td>@orden.NumeroOrden</td>
                    <td>@orden.NombreCliente</td>
                    <td>@orden.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@orden.Total.ToString("C")</td>
                    <td>
                        <span class="orden-badge @estadoClase">@orden.Estado</span>
                    </td>
                    <td>
                        <!-- Botón para ver detalle -->
                        <a asp-controller="Admin" asp-action="DetalleOrden" asp-route-idOrden="@orden.IdOrden" class="btn ghost btn-sm">
                            Ver detalle
                        </a>

                        @if (orden.Estado.ToLower() == "pendiente")
                        {
                            <form asp-controller="Admin" asp-action="ActualizarEstado" method="post" style="display:inline;">
                                <input type="hidden" name="idOrden" value="@orden.IdOrden" />
                                <select name="nuevoEstado" class="input" style="padding:3px 6px; border-radius:6px;">
                                    <option value="Pagado">Pagado</option>
                                    <option value="Cancelado">Cancelado</option>
                                </select>
                                <button type="submit" class="btn primary btn-sm">Actualizar</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">Sin acción</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>