@model ProyectoPyme.Models.Orden

@{
    ViewData["Title"] = "Finalizar Compra";
}

<h2 class="checkout-title">📦 Finalizar Compra</h2>

<div class="checkout-container">

    <form asp-action="CrearOrden" method="post">

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="NombreCliente" class="form-input" />
        </div>

        <div class="form-group">
            <label>Dirección</label>
            <input asp-for="Direccion" class="form-input" />
        </div>

        <div class="form-group">
            <label>Teléfono</label>
            <input asp-for="Telefono" class="form-input" />
        </div>

        <div class="form-group">
            <label>Método de Pago</label>
            <select asp-for="MetodoPago" class="form-input">
                <option value="Tarjeta">Tarjeta</option>
                <option value="Efectivo">Efectivo</option>
            </select>
        </div>

        <div class="checkout-buttons">

            <a asp-controller="Carrito" asp-action="Index" class="btn secondary">
                Volver al carrito
            </a>

            <button type="submit" class="btn primary">
                Confirmar Pedido
            </button>

        </div>

    </form>

</div>