@model ProyectoPyme.Models.Orden

@{
    ViewData["Title"] = "Finalizar Compra";
}

<h2 class="checkout-title">Finalizar Compra</h2>

<div class="checkout-container">

    <form asp-action="CrearOrden" method="post">

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="NombreCliente" class="form-input" required />
        </div>

        <div class="form-group">
            <label>Direccion</label>
            <input asp-for="Direccion" class="form-input" required />
        </div>

        <div class="form-group">
            <label>Telefono</label>
            <input asp-for="Telefono" class="form-input" required />
        </div>

        <div class="form-group">
            <label>Metodo de Pago</label>
            <select asp-for="MetodoPago" class="form-input" id="metodoPago">
                <option value="Stripe">Stripe</option>
                <option value="Tarjeta">Tarjeta</option>
                <option value="Efectivo">Efectivo</option>
            </select>
        </div>

        <div class="checkout-buttons">

            <a asp-controller="Carrito" asp-action="Index" class="btn secondary">
                Volver al carrito
            </a>

            <button type="submit" class="btn primary" id="btnPagar">
                Pagar con Stripe
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <script>
        document.getElementById('metodoPago').addEventListener('change', function () {
            var btn = document.getElementById('btnPagar');
            var textos = {
                'Stripe': 'Pagar con Stripe',
                'Tarjeta': 'Pagar con Tarjeta',
                'Efectivo': 'Pagar en Efectivo'
            };
            btn.textContent = textos[this.value] || 'Confirmar Pedido';
        });
    </script>
}