<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Perfumería Thompson</title>
    <link rel="icon" type="image/png" href="~/images/Productos/TH-1.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-container">
            <div class="navbar-left">
                <a href="/" class="logo">
                    <img src="@Url.Content(ImagePaths.Productos + "/Elegant Perfume Shop Logo with Gold Accents-1.jpg")" alt="Perfumería Thompson" class="logo-img">
                </a>
                <nav class="nav-links">
                    <a href="/Home/Index"><i class="fa-solid fa-house"></i> Inicio</a>
                    <a href="/Categorias"><i class="fa-solid fa-layer-group"></i> Categorías</a>
                    <a href="/Productos"><i class="fa-solid fa-droplet"></i> Productos</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Productos/Create" class="admin-link"><i class="fa-solid fa-plus"></i> Nuevo Producto</a>
                        <a href="/Admin/Ordenes" class="admin-link"><i class="fa-solid fa-receipt"></i> Órdenes de Clientes</a>
                    }
                </nav>
            </div>
            <div class="navbar-search">
                <form action="/Productos" method="get" class="navbar-search-form" id="searchForm">
                    <input type="text" name="q" id="ajaxSearchInput" class="navbar-search-input" placeholder="Buscar perfumes, categorías, esencias..." value="@Context.Request.Query["q"]" autocomplete="off" />
                    <button type="submit" class="navbar-search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
                <div id="searchDropdown" class="search-dropdown"></div>
                <div id="searchError" class="search-error-toast" style="display:none;"></div>
            </div>
            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    var isCarrito = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").Equals("Carrito", System.StringComparison.OrdinalIgnoreCase);
                    var carritoBtnClass = isCarrito ? "btn carrito-btn carrito-btn-active" : "btn carrito-btn";
                    <a href="/Carrito" class="@carritoBtnClass"><i class="fa-solid fa-cart-shopping"></i> Carrito</a>
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="user-info">
                        <i class="fa-solid fa-user"></i> Hola, <strong>@User.Identity.Name</strong>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge admin"><i class="fa-solid fa-shield-halved"></i> Admin</span>
                        }
                        else
                        {
                            <span class="badge cliente"><i class="fa-solid fa-user"></i> Cliente</span>
                        }
                    </span>
                    <form asp-controller="Cuentas" asp-action="Logout" method="post">
                        <button type="submit" class="btn logout"><i class="fa-solid fa-right-from-bracket"></i> Salir</button>
                    </form>
                }
                else
                {
                    <a href="/Cuentas/Login" class="btn login"><i class="fa-solid fa-right-to-bracket"></i> Iniciar sesión</a>
                    <a asp-controller="Cuentas" asp-action="Register" class="btn ghost">Registrarse</a>
                }
            </div>
        </div>
    </header>
    <main class="main-container">
        @RenderBody()
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    @* AJAX Live Search *@
    <script>
    $(function () {
        var $input    = $('#ajaxSearchInput'),
            $dropdown = $('#searchDropdown'),
            $toast    = $('#searchError'),
            timer     = null;

        // ── Utilidad: escapar HTML para evitar XSS ──
        function esc(s) {
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(s));
            return d.innerHTML;
        }

        // ── Mostrar toast de error (client-side, NO afecta middleware) ──
        function showToast(msg) {
            $toast.html('<i class="fa-solid fa-triangle-exclamation"></i> ' + esc(msg))
                  .fadeIn(200);
            setTimeout(function () { $toast.fadeOut(300); }, 4000);
        }

        // ── Evento: tecleo con debounce 300 ms ──
        $input.on('input', function () {
            clearTimeout(timer);
            var q = $.trim($input.val());

            if (q.length < 2) { $dropdown.hide().empty(); return; }

            timer = setTimeout(function () {
                $.ajax({
                    url: '/Productos/BuscarAjax',
                    data: { q: q },
                    type: 'GET',
                    dataType: 'json',
                    timeout: 5000,

                    success: function (data) {
                        $dropdown.empty();
                        if (!data || data.length === 0) {
                            $dropdown.html('<div class="sr-empty">Sin resultados para "' + esc(q) + '"</div>').show();
                            return;
                        }
                        $.each(data, function (_, p) {
                            var avail = p.disponibilidad
                                ? '<span class="sr-avail in">Disponible</span>'
                                : '<span class="sr-avail out">Agotado</span>';
                            var img = p.imagen
                                ? '<img class="sr-img" src="' + esc(p.imagen) + '" alt="">'
                                : '<div class="sr-img sr-noimg"><i class="fa-solid fa-image"></i></div>';
                            $dropdown.append(
                                '<a class="sr-item" href="/Productos/Details/' + p.productoId + '">' +
                                    img +
                                    '<div class="sr-info">' +
                                        '<span class="sr-name">' + esc(p.nombre) + '</span>' +
                                        '<span class="sr-meta">' + esc(p.categoria) + ' · ' + esc(p.esencia) + '</span>' +
                                        '<span class="sr-price">₡' + esc(p.precio) + '</span> ' + avail +
                                    '</div>' +
                                '</a>'
                            );
                        });
                        $dropdown.show();
                    },

                    error: function (xhr, status) {
                        $dropdown.hide().empty();
                        if (status === 'timeout')       showToast('La búsqueda tardó demasiado. Intentá de nuevo.');
                        else if (xhr.status === 0)      showToast('Sin conexión al servidor.');
                        else if (xhr.status === 403)    showToast('No tenés permiso para esta acción.');
                        else if (xhr.status >= 500)     showToast('Error del servidor (' + xhr.status + '). Intentá más tarde.');
                        else                            showToast('Error inesperado (' + (xhr.status || status) + ').');
                    }
                });
            }, 300);
        });

        // ── Cerrar dropdown al hacer clic fuera ──
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.navbar-search').length) $dropdown.hide();
        });

        // ── AJAX SEGURIDAD: Interceptar links admin ──
        $(document).on('click', 'a[href^="/Admin"]', function (e) {
            e.preventDefault();
            var destino = $(this).attr('href');
            $.ajax({
                url: '/Admin/VerificarSesion',
                type: 'GET', dataType: 'json', timeout: 3000,
                success: function (data) {
                    if (data.autenticado && data.esAdmin) {
                        window.location.href = destino;
                    } else if (data.autenticado) {
                        showToast('⛔ Acceso denegado — se requiere rol Admin.', 'warn');
                    } else {
                        showToast('Debés iniciar sesión primero.', 'info');
                        setTimeout(function () { window.location.href = '/Cuentas/Login'; }, 1500);
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 403 || xhr.status === 401) showToast('⛔ Acceso denegado.', 'warn');
                    else showToast('Error al verificar permisos.');
                }
            });
        });
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>