<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoPyme</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-container">
            <div class="navbar-left">
                <a href="/" class="logo">
                    <img src="@Url.Content(ImagePaths.Productos + "/Elegant Perfume Shop Logo with Gold Accents.jpg")" alt="Perfumería Thompson" class="logo-img">
                </a>
                <nav class="nav-links">
                    <a href="/Home/Index"><i class="fa-solid fa-house"></i> Inicio</a>
                    <a href="/Categorias"><i class="fa-solid fa-layer-group"></i> Categorías</a>
                    <a href="/Productos"><i class="fa-solid fa-droplet"></i> Productos</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Productos/Create" class="admin-link"><i class="fa-solid fa-plus"></i> Nuevo Producto</a>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Ordenes", "Admin")">Órdenes de Clientes</a>
                        </li>
                    }
                </nav>
            </div>
            <div class="navbar-search">
                <form action="/Productos" method="get" class="navbar-search-form">
                    <input type="text" name="q" class="navbar-search-input" placeholder="Buscar perfumes, categorías, esencias..." value="@Context.Request.Query["q"]" autocomplete="off" />
                    <button type="submit" class="navbar-search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
            </div>
            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    var isCarrito = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").Equals("Carrito", System.StringComparison.OrdinalIgnoreCase);
                    var carritoBtnClass = isCarrito ? "btn carrito-btn carrito-btn-active" : "btn carrito-btn";
                    <a href="/Carrito" class="@carritoBtnClass"><i class="fa-solid fa-cart-shopping"></i> Carrito</a>
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="user-info">
                        <i class="fa-solid fa-user"></i> Hola, <strong>@User.Identity.Name</strong>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge admin"><i class="fa-solid fa-shield-halved"></i> Admin</span>
                        }
                        else
                        {
                            <span class="badge cliente"><i class="fa-solid fa-user"></i> Cliente</span>
                        }
                    </span>
                    <form asp-controller="Cuentas" asp-action="Logout" method="post">
                        <button type="submit" class="btn logout"><i class="fa-solid fa-right-from-bracket"></i> Salir</button>
                    </form>
                }
                else
                {
                    <a href="/Cuentas/Login" class="btn login"><i class="fa-solid fa-right-to-bracket"></i> Iniciar sesión</a>
                    <a asp-controller="Cuentas" asp-action="Register" class="btn ghost">Registrarse</a>
                }
            </div>
        </div>
    </header>
    <main class="main-container">
        @RenderBody()
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>