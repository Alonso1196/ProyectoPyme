<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Perfumería Thompson</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
    <header class="navbar">
        <div class="navbar-container">
            <div class="navbar-left">
                <a href="/" class="logo">
                    <img src="@Url.Content(ImagePaths.Productos + "/Elegant Perfume Shop Logo with Gold Accents.jpg")" alt="Perfumería Thompson" class="logo-img">
                </a>
                <nav class="nav-links">
                    <a href="/Home/Index">Inicio</a>
                    <a href="/Categorias">Categoría</a>
                    <a href="/Productos">Productos</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Productos/Create" class="admin-link">Nuevo Producto</a>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Ordenes", "Admin")">Órdenes de Clientes</a>
                        </li>
                    }
                </nav>
            </div>
            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    <a href="/Carrito" class="btn primary amber" style="margin-right:18px;">Carrito</a>
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="user-info">
                        Hola, <strong>@User.Identity.Name</strong>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge admin">Admin</span>
                        }
                        else
                        {
                            <span class="badge cliente">Cliente</span>
                        }
                    </span>
                    <form asp-controller="Cuentas" asp-action="Logout" method="post">
                        <button type="submit" class="btn logout">Salir</button>
                    </form>
                }
                else
                {
                    <a href="/Cuentas/Login" class="btn login">Iniciar sesión</a>
                    <a asp-controller="Cuentas" asp-action="Register" class="btn ghost">Registrarse</a>
                }
            </div>
        </div>
    </header>
    <main class="main-container">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>