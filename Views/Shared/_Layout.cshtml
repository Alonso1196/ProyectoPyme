<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoPyme</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="navbar-container">

            <div class="navbar-left">
                <a href="/" class="logo">ProyectoPyme</a>

                <a href="/Home/Index">Inicio</a>
                <a href="/Productos">Productos</a>
                <a href="/Categorias">Categorías</a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Productos/Create" class="admin-link">Nuevo Producto</a>
                }
            </div>

            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="user-info">
                        Hola, <strong>@User.Identity.Name</strong>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge admin">Admin</span>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <span class="badge cliente">Cliente</span>
                        }
                    </span>

                    <form method="post" action="/Cuentas/Logout">
                        <button type="submit" class="btn logout">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a href="/Cuentas/Login" class="btn login">Iniciar sesión</a>
                }
            </div>

        </div>
    </header>

    <!-- CONTENIDO -->
    <main class="main-container">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        &copy; 2026 - ProyectoPyme
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
