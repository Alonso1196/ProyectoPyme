@model ProyectoPyme.Models.Productos
@{ ViewData["Title"] = "Eliminar producto"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="ordenes-container">
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <h2><i class="fa-solid fa-trash" style="color:#f87171;"></i> Eliminar producto</h2>
    <a href="/Admin/Productos" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Volver</a>
</div>
<div class="form-card">
    <div class="delete-box">
        <p style="color:var(--text-sec);">Vas a eliminar:</p>
        <h3>@Model.Nombre</h3>
        <p class="muted">Precio: <strong style="color:var(--amber-light);">₡@Model.Precio.ToString("N2")</strong></p>
        <p class="muted">Categoría: @Model.Categoria?.Nombre</p>
        <form asp-action="Delete" method="post" class="actions" style="margin-top:20px;">
            <input type="hidden" asp-for="ProductoId" />
            <button type="submit" class="btn danger"><i class="fa-solid fa-trash"></i> Sí, eliminar</button>
            <a href="/Admin/Productos" class="btn-back">Cancelar</a>
        </form>
    </div>
</div>
</div>
