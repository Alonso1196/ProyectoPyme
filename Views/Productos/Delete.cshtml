@model ProyectoPyme.Models.Productos

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="page-header">
    <div>
        <h2>Eliminar producto</h2>
        <p class="muted">Esta acción no se puede deshacer</p>
    </div>
    <a href="/Productos" class="btn ghost">Volver</a>
</div>

<div class="form-card">
    <div class="delete-box">
        <p>Vas a eliminar:</p>
        <h3>@Model.Nombre</h3>
        <p class="muted">Precio: ₡@Model.Precio</p>
        <p class="muted">Categoría: @Model.Categoria?.Nombre</p>

        <form asp-action="Delete" method="post" class="actions" style="margin-top:16px;">
            <input type="hidden" asp-for="ProductoId" />
            <button type="submit" class="btn danger">Sí, eliminar</button>
            <a href="/Productos" class="btn ghost">Cancelar</a>
        </form>
    </div>
</div>
