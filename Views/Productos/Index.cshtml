@model IEnumerable<ProyectoPyme.Models.Productos>

@{
    ViewData["Title"] = "Productos";
}

<div class="page-header">
    <div>
        <h2>Productos</h2>
        <p class="muted">Disponibilidad de artículos</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a href="/Productos/Create" class="btn primary">+ Nuevo producto</a>
    }
</div>

<div class="card-grid">
    @foreach (var p in Model)
    {
        <div class="card">

            @if (!string.IsNullOrEmpty(p.RutaImagen))
            {
                <img src="@p.RutaImagen" alt="@p.Nombre" class="product-img" />
            }
            else
            {
                <div class="img-placeholder">Sin imagen</div>
            }

            <div class="card-body">

                <h3 class="card-title">@p.Nombre</h3>

                <div class="meta">
                    <span class="price">₡@p.Precio.ToString("N2")</span>

                    <span class="pill @(p.Disponibilidad ? "ok" : "bad")">
                        @(p.Disponibilidad ? "Disponible" : "No disponible")
                    </span>
                </div>

                <p class="muted">Categoría: <strong>@p.Categoria?.Nombre</strong></p>
                <p class="muted">Esencia: <strong>@p.Esencia?.Nombre</strong></p>

                <div class="actions">

                    @* ADMIN *@
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Productos/Edit/@p.ProductoId" class="btn ghost">Editar</a>
                        <a href="/Productos/Delete/@p.ProductoId" class="btn danger">Eliminar</a>
                    }

                    @* USUARIO LOGUEADO *@
                    else if (User.Identity.IsAuthenticated)
                    {
                        if (p.Disponibilidad)
                        {
                            <a asp-controller="Carrito"
                               asp-action="Agregar"
                               asp-route-id="@p.ProductoId"
                               class="btn primary">
                                <i class="fa-solid fa-cart-shopping"></i> Agregar al carrito
                            </a>
                        }
                        else
                        {
                            <button class="btn ghost" disabled>
                                No disponible
                            </button>
                        }
                    }

                    @* VISITANTE *@
                    else
                    {
                        <a asp-controller="Cuentas"
                           asp-action="Login"
                           class="btn ghost">
                            Iniciar sesión para comprar
                        </a>
                    }

                </div>

            </div>
        </div>
    }
</div>