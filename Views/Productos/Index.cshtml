@model IEnumerable<ProyectoPyme.Models.Productos>


@{ ViewData["Title"] = "Productos"; Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_Layout.cshtml"; }

@{
    var showSuccess = Context.Request.Query["success"] == "true";
}
@if (showSuccess)
{
    <script>
        window.addEventListener('DOMContentLoaded', function() {
            alert('Operación realizada correctamente.');
        });
    </script>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (User.IsInRole("Admin"))
{
    <div class="page-header">
        <div>
            <h2><i class="fa-solid fa-droplet" style="color:var(--blue-light);"></i> Perfumes</h2>
            <p class="muted">Catálogo de fragancias y perfumes de lujo</p>
        </div>
        <a href="/Productos/Create" class="btn primary"><i class="fa-solid fa-plus"></i> Nuevo perfume</a>
    </div>
    <div class="search-bar">
        <div class="search-field">
            <label for="adminProductSearch"><i class="fa-solid fa-magnifying-glass"></i> Búsqueda</label>
            <input type="text" id="adminProductSearch" class="search-input" placeholder="Nombre, categoría, esencia..." />
        </div>
        <button id="btnDisponibilidad" class="filter-btn"><i class="fa-solid fa-check-circle"></i> Ver Solo Disponibles</button>
        <button id="btnSortPrecio" class="filter-btn"><i class="fa-solid fa-arrow-down-wide-short"></i> Ordenar por Precio ↓</button>
    </div>
    <div class="admin-table-wrap">
        <table id="adminProductosTable" class="admin-table">
            <thead>
                <tr>
                    <th>ID</th><th>Nombre</th><th>Categoría</th><th>Esencia</th><th>Precio</th>
                    <th style="text-align:center;">Disponibilidad</th><th style="text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.ProductoId</td>
                        <td class="text-white">@p.Nombre</td>
                        <td><span class="u-category" style="display:inline-block;">@p.Categoria?.Nombre</span></td>
                        <td>@p.Esencia?.Nombre</td>
                        <td class="text-amber">₡@p.Precio.ToString("N2")</td>
                        <td style="text-align:center;">
                            @if (p.Disponibilidad)
                            {
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--green);"><i class="fa-solid fa-check" style="color:#fff;font-size:12px;"></i></span>
                            }
                            else
                            {
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--red);"><i class="fa-solid fa-xmark" style="color:#fff;font-size:12px;"></i></span>
                            }
                        </td>
                        <td>
                            <div class="action-btns">
                                <a href="/Productos/Edit/@p.ProductoId" class="action-btn edit" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <a href="/Productos/Delete/@p.ProductoId" class="action-btn delete" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h2><i class="fa-solid fa-droplet" style="color:var(--blue-light);"></i> Perfumes</h2>
            <p class="muted">Catálogo de fragancias y perfumes de lujo</p>
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery))
            {
                <p class="search-result-info">
                    Resultados para: <strong>"@ViewBag.SearchQuery"</strong>
                    <a href="/Productos" class="search-clear"><i class="fa-solid fa-xmark"></i> Limpiar</a>
                </p>
            }
        </div>
    </div>
    <div class="search-bar">
        <button id="btnDisponibilidadClient" class="filter-btn"><i class="fa-solid fa-check-circle"></i> Ver Solo Disponibles</button>
    </div>
    <div class="user-product-cards">
        @foreach (var p in Model)
        {
            <div class="u-product-card">
                @if (!string.IsNullOrEmpty(p.RutaImagen))
                { <img src="@p.RutaImagen" alt="@p.Nombre" class="u-img" /> }
                else
                { <div class="u-img-placeholder"><i class="fa-solid fa-droplet" style="font-size:40px;opacity:.3;"></i></div> }
                <div class="u-body">
                    <h3 class="u-name">@p.Nombre</h3>
                    <span class="u-category">@p.Categoria?.Nombre</span>
                    <p class="u-esencia"><strong>Esencia:</strong> @p.Esencia?.Nombre</p>
                    <div class="u-price-row">
                        <span class="u-price">₡@p.Precio.ToString("N2")</span>
                        <span class="u-availability">
                            @if (p.Disponibilidad)
                            { <span class="u-dot ok"></span><span class="u-avail-ok">Disponible</span> }
                            else
                            { <span class="u-dot bad"></span><span class="u-avail-bad">Agotado</span> }
                        </span>
                    </div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        if (p.Disponibilidad)
                        {
                            <a asp-controller="Carrito" asp-action="Agregar" asp-route-id="@p.ProductoId" class="btn primary" style="width:100%;justify-content:center;">
                                <i class="fa-solid fa-cart-shopping"></i> Agregar al carrito
                            </a>
                        }
                        else
                        { <button class="btn ghost" disabled style="width:100%;justify-content:center;opacity:.5;">No disponible</button> }
                    }
                    else
                    {
                        <a asp-controller="Cuentas" asp-action="Login" class="btn ghost" style="width:100%;justify-content:center;">Iniciar sesión para comprar</a>
                    }
                </div>
            </div>
        }
    </div>
    <div class="no-results" id="noResultsClient">No se encontraron perfumes con ese criterio.</div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // ===================== ADMIN: DataTable =====================
            if ($('#adminProductosTable').length) {
                var table = $('#adminProductosTable').DataTable({
                    paging: true, searching: true, pageLength: 10, lengthMenu: [5, 10, 25, 50],
                    language: {
                        lengthMenu: "Mostrar _MENU_ por página",
                        zeroRecords: "No se encontraron resultados",
                        info: "Mostrando página _PAGE_ de _PAGES_",
                        infoEmpty: "No hay registros disponibles",
                        infoFiltered: "(filtrado de _MAX_ registros totales)",
                        search: "Buscar:",
                        paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                    }
                });

                $('#adminProductSearch').on('keyup', function () {
                    table.search($(this).val()).draw();
                });

                var showAvailable = false;
                $.fn.dataTable.ext.search.push(function (settings, data) {
                    if (settings.nTable.id !== 'adminProductosTable') return true;
                    if (!showAvailable) return true;
                    var cell = data[5];
                    return cell && cell.trim() !== '' && !cell.includes('xmark');
                });
                $('#btnDisponibilidad').on('click', function () {
                    showAvailable = !showAvailable;
                    $(this).html(showAvailable
                        ? '<i class="fa-solid fa-list"></i> Ver Todos'
                        : '<i class="fa-solid fa-check-circle"></i> Ver Solo Disponibles');
                    $(this).toggleClass('active');
                    table.draw();
                });

                var precioAsc = false;
                $('#btnSortPrecio').on('click', function () {
                    var order = precioAsc ? 'asc' : 'desc';
                    table.order([4, order]).draw();
                    precioAsc = !precioAsc;
                    $(this).html('<i class="fa-solid fa-arrow-down-wide-short"></i> Ordenar por Precio ' + (precioAsc ? '↑' : '↓'));
                });
            }

            // ===================== CLIENTE: Filtro disponibilidad =====================
            if ($('#btnDisponibilidadClient').length) {
                var showAvailClient = false;

                function filterClientCards() {
                    var visible = 0;
                    $('.u-product-card').each(function () {
                        var isAvail = $(this).find('.u-avail-ok').length > 0;
                        var matchFilter = !showAvailClient || isAvail;
                        if (matchFilter) {
                            $(this).show();
                            visible++;
                        } else {
                            $(this).hide();
                        }
                    });
                    $('#noResultsClient').toggle(visible === 0);
                }

                $('#btnDisponibilidadClient').on('click', function () {
                    showAvailClient = !showAvailClient;
                    $(this).html(showAvailClient
                        ? '<i class="fa-solid fa-list"></i> Ver Todos'
                        : '<i class="fa-solid fa-check-circle"></i> Ver Solo Disponibles');
                    $(this).toggleClass('active');
                    filterClientCards();
                });
            }
        });
    </script>
}
