@model ProyectoPyme.Models.Productos

@{
    ViewData["Title"] = "Editar Producto";
}

<h2>Editar Producto</h2>
<hr />

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="ProductoId" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoriaId">Categoría</label>
        <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Disponibilidad">Disponibilidad</label>
        <select asp-for="Disponibilidad" class="form-control">
            <option value="true">Disponible</option>
            <option value="false">No disponible</option>
        </select>
        <span asp-validation-for="Disponibilidad" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="control-label">Imagen (opcional)</label>
        <input type="file" name="Imagen" class="form-control" accept="image/*" />
    </div>

    @if (!string.IsNullOrEmpty(Model.RutaImagen))
    {
        <div class="mt-2">
            <p><strong>Imagen actual:</strong></p>
            <img src="@Model.RutaImagen" style="width:120px; height:120px; object-fit:cover;" />
        </div>
    }

    <br />

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
