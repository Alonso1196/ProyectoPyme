@model ProyectoPyme.Models.Productos

@{
    ViewData["Title"] = "Editar producto";
}

<h2>Editar producto</h2>

<!-- ✅ Muestra errores si ModelState falla -->
<div asp-validation-summary="All" class="error"></div>

<form asp-action="Edit" asp-route-id="@Model.ProductoId" method="post" enctype="multipart/form-data" class="form-card">
    @Html.AntiForgeryToken()

    <!-- ✅ IMPORTANTES -->
    <input type="hidden" asp-for="ProductoId" />
    <input type="hidden" asp-for="RutaImagen" />

    <div class="form-grid">
        <div class="field">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="input" />
            <span asp-validation-for="Nombre" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="Precio"></label>
            <input asp-for="Precio" class="input" />
            <span asp-validation-for="Precio" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="CategoriaId">Categoría</label>
            <select asp-for="CategoriaId" class="input" asp-items="ViewBag.Categorias"></select>
            <span asp-validation-for="CategoriaId" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="EsenciaId">Esencia</label>
            <select asp-for="EsenciaId" class="input" asp-items="ViewBag.Esencias"></select>
            <span asp-validation-for="EsenciaId" class="error"></span>
        </div>

        <div class="field">
            <label asp-for="Disponibilidad"></label>
            <select asp-for="Disponibilidad" class="input">
                <option value="true">Sí</option>
                <option value="false">No</option>
            </select>
            <span asp-validation-for="Disponibilidad" class="error"></span>
        </div>

        <div class="field full">
            <label>Imagen actual</label>
            @if (!string.IsNullOrEmpty(Model.RutaImagen))
            {
                <img src="@Model.RutaImagen" alt="@Model.Nombre" class="product-img preview" />
            }
            else
            {
                <div class="img-placeholder preview">Sin imagen</div>
            }

            <label style="margin-top:10px;">Cambiar imagen (opcional)</label>
            <input type="file" name="Imagen" class="input" accept="image/*" />
        </div>
    </div>

    <div class="actions" style="margin-top:14px;">
        <button type="submit" class="btn primary">Guardar</button>
        <a href="/Productos" class="btn ghost">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
